{
  "name": "NBIM Investment Fund Theme",
  "dataColors": [
    "#00205B",
    "#0056B3",
    "#2E8BC0",
    "#5AB4E5",
    "#8ED1F0",
    "#B8E2F8",
    "#C4A35A",
    "#E8D5A3",
    "#7A8B99",
    "#A3B5C4"
  ],
  "background": "#000000",
  "foreground": "#FFFFFF",
  "tableAccent": "#00205B",
  "maximum": "#C4A35A",
  "center": "#5AB4E5",
  "minimum": "#00205B",
  "good": "#4CAF50",
  "neutral": "#C4A35A",
  "bad": "#E74C3C",
  "textClasses": {
    "callout": {
      "fontSize": 36,
      "fontFace": "Segoe UI Light",
      "color": "#FFFFFF"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI",
      "color": "#FFFFFF"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI",
      "color": "#A3B5C4"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#7A8B99"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#0A0A0A" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "color": { "solid": { "color": "#1A1A2E" } },
            "radius": 0
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 11,
            "fontFamily": "Segoe UI",
            "alignment": "left"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#000000" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 36,
            "fontFamily": "Segoe UI Light"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#7A8B99" } },
            "fontSize": 10
          }
        ]
      }
    },
    "table": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#1A1A2E" } },
            "gridHorizontalWeight": 1,
            "rowPadding": 6
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#7A8B99" } },
            "backColor": { "solid": { "color": "#000000" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "backColorPrimary": { "solid": { "color": "#000000" } },
            "fontColorSecondary": { "solid": { "color": "#FFFFFF" } },
            "backColorSecondary": { "solid": { "color": "#0A0A0A" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "total": [
          {
            "fontColor": { "solid": { "color": "#C4A35A" } },
            "backColor": { "solid": { "color": "#0A0A0A" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "background": { "solid": { "color": "#0A0A0A" } },
            "fontSize": 10
          }
        ],
        "selection": [
          {
            "selectAllCheckboxEnabled": true,
            "singleSelect": false
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "lineStyle": "solid"
          }
        ],
        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#7A8B99" } },
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "labelColor": { "solid": { "color": "#7A8B99" } },
            "gridlineColor": { "solid": { "color": "#1A1A2E" } },
            "gridlineShow": true,
            "fontSize": 9
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#7A8B99" } },
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "labelColor": { "solid": { "color": "#7A8B99" } },
            "gridlineColor": { "solid": { "color": "#1A1A2E" } },
            "fontSize": 9
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          {
            "labelColor": { "solid": { "color": "#A3B5C4" } },
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 9
          }
        ]
      }
    },
    "map": {
      "*": {
        "legend": [
          {
            "labelColor": { "solid": { "color": "#A3B5C4" } },
            "fontSize": 9
          }
        ]
      }
    }
  }
}
