              "description": "Main investment holdings data table - the core of the page",
              "bounds": { "x": 0, "y": 268, "width": 1440, "height": 620 },
              "visuals": [
                {
                  "type": "table",
                  "title": "",
                  "bounds": { "x": 60, "y": 0, "width": 1320, "height": 610 },
                  "columns": [
                    {
                      "field": "Holdings[Company Name]",
                      "header": "Company",
                      "width": 320,
                      "alignment": "left"
