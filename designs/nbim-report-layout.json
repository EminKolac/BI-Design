                    {
                      "field": "Geography[Country]",
                      "header": "Country",
                      "width": 160,
                      "alignment": "left"
                    },
                    {
                      "field": "AssetClass[Name]",
                      "header": "Asset class",
                      "width": 140,
                      "alignment": "left"
                    },
                    {
                      "field": "Sector[Name]",
                      "header": "Sector",
                      "width": 200,
                      "alignment": "left"
                    },
                    {
                      "field": "Holdings[Voting Share Pct]",
                      "header": "Voting shares (%)",
                      "width": 150,
                      "alignment": "right",
                      "format": "0.00%"
                    },
                    {
                      "field": "Holdings[Market Value NOK]",
                      "header": "Market value (NOK)",
                      "width": 180,
                      "alignment": "right",
                      "format": "#,##0"
