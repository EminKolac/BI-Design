                    "rowFontColor": "#FFFFFF",
                    "rowFontSize": 11,
                    "rowFontFamily": "Segoe UI",
                    "rowBorderBottom": "#0D0D1A",
                    "rowHoverBackground": "#0A0A1E",
                    "rowPadding": 8,
                    "pagination": {
                      "enabled": true,
                      "rowsPerPage": 25,
                      "style": {
                        "fontColor": "#7A8B99",
                        "activeColor": "#FFFFFF"
                      }
                    }
                  },
                  "sorting": {
                    "defaultColumn": "Holdings[Market Value NOK]",
                    "defaultDirection": "descending"
                  }
                }
              ]
            }
          ]
        }
      },
      {
